# Скопируйте в .env и подставьте свой ключ. Файл .env в git не попадает.
OPENROUTER_API_KEY=sk-or-...

# Адрес OpenAI-совместимого входа. Для другого агрегатора меняется только он.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Модель в формате вендор/модель.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Резервные модели через запятую: пробуются по порядку, если основная отказала.
# OPENROUTER_FALLBACK_MODELS=anthropic/claude-3.5-haiku,google/gemini-flash-1.5

# Какая реализация работает: httpx (по умолчанию) или openai.
CHAT_BACKEND=httpx

# Атрибуция приложения в статистике агрегатора.
OPENROUTER_APP_URL=http://localhost
OPENROUTER_APP_TITLE=OpenRouter Chat Example

# Параметры генерации.
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=1024
CHAT_TIMEOUT_SECONDS=60
